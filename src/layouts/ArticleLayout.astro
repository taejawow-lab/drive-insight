---
import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import References from '../components/References.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
  category?: string;
  sources?: Array<{ title: string; url: string; author?: string; year?: string }>;
  affiliate?: boolean;
  visualsCount?: number;
  hasVideo?: boolean;
  headings?: Array<{ depth: number; slug: string; text: string }>;
}

const { title, description, pubDate, updatedDate, heroImage, tags = [], category, sources = [], affiliate = false, visualsCount = 0, hasVideo = false, headings = [] } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: heroImage,
  datePublished: pubDate?.toISOString(),
  dateModified: (updatedDate || pubDate)?.toISOString(),
  author: { '@type': 'Organization', name: import.meta.env.PUBLIC_SITE_NAME + ' Editorial Team', url: import.meta.env.PUBLIC_SITE_URL },
  publisher: { '@type': 'NewsMediaOrganization', name: import.meta.env.PUBLIC_SITE_NAME, url: import.meta.env.PUBLIC_SITE_URL },
};
---

<BaseLayout title={title} description={description} image={heroImage} type="article" publishedTime={pubDate?.toISOString()} modifiedTime={(updatedDate || pubDate)?.toISOString()} schema={schema}>
  <article class="site-shell py-12 md:py-16">
    <header class="grid gap-8 border-b border-border pb-10 lg:grid-cols-[1fr_340px]">
      <div>
        <div class="mb-5 flex flex-wrap gap-2">
          {category && <a href={`/category/${category.toLowerCase()}`} class="technical-chip">{category}</a>}
          <span class="verified-badge">ASE Certified review model</span>
          <span class="safety-badge">Safety-critical claims checked</span>
        </div>
        <h1 class="max-w-5xl text-balance text-4xl font-black leading-none md:text-7xl">{title}</h1>
        <p class="mt-6 max-w-3xl text-pretty text-lg leading-8 text-muted-foreground md:text-xl">{description}</p>
        <div class="mt-7 flex flex-wrap items-center gap-4 text-xs font-bold uppercase tracking-[0.14em] text-muted-foreground">
          <time datetime={pubDate?.toISOString()}>Published {pubDate?.toLocaleDateString('en-US')}</time>
          {updatedDate && updatedDate.getTime() !== pubDate.getTime() && <time datetime={updatedDate.toISOString()} class="text-primary">Updated {updatedDate.toLocaleDateString('en-US')}</time>}
          <span>{sources.length} primary sources</span>
          {visualsCount > 0 && <span>{visualsCount} visuals</span>}
          {hasVideo && <span class="text-accent">Video summary</span>}
        </div>
      </div>
      <aside class="ledger-card">
        <span class="technical-chip">Report Integrity</span>
        <div class="mt-5 grid grid-cols-2 gap-3">
          <div class="data-readout"><span class="value">{sources.length}</span><span class="label">Sources cited</span></div>
          <div class="data-readout"><span class="value">{visualsCount}</span><span class="label">Visual checks</span></div>
        </div>
        <p class="mt-5 text-sm leading-6 text-muted-foreground">Drive-Insight reports separate owner anecdotes from official safety data, maintenance manuals, recall notices, and parts-longevity evidence.</p>
      </aside>
    </header>

    {heroImage && <img src={heroImage} alt={title} class="my-10 aspect-[16/9] w-full rounded border border-border object-cover opacity-90" />}

    {affiliate && <AffiliateDisclosure />}

    <div class="grid grid-cols-1 gap-10 py-10 lg:grid-cols-[1fr_300px]">
      <div class="prose-article min-w-0">
        <slot />
        {sources.length > 0 && <References sources={sources} />}
      </div>
      <aside class="hidden lg:block">
        <div class="sticky top-28 space-y-4">
          {headings.length > 0 && <TOC headings={headings} />}
          <div class="ledger-card text-sm leading-6 text-muted-foreground">
            <strong class="block text-foreground">Safety note</strong>
            Use these guides for planning and questions to ask a qualified technician. Confirm recall and repair actions against the manufacturer, NHTSA, and local service documentation.
          </div>
        </div>
      </aside>
    </div>

    {tags.length > 0 && (
      <footer class="mt-8 border-t border-border pt-8">
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => <a href={`/tags/${tag}`} class="technical-chip">#{tag}</a>)}
        </div>
      </footer>
    )}
  </article>
</BaseLayout>
