---
export interface Props {
  title: string;
  description: string;
  href: string;
  image?: string;
  category?: string;
  pubDate: Date;
  readingTime?: number;
  variant?: 'feature' | 'standard' | 'compact';
  index?: number;
}

const { title, description, href, image, category, pubDate, readingTime, variant = 'standard', index = 0 } = Astro.props;
const isFeature = variant === 'feature';
---

<article class:list={['ledger-card group flex h-full flex-col overflow-hidden p-0', isFeature && 'md:min-h-[640px]']}>
  <a href={href} class="flex h-full flex-col">
    {image ? (
      <div class="relative aspect-[16/9] overflow-hidden border-b border-border bg-muted">
        <img src={image} alt={title} loading="lazy" class="h-full w-full object-cover opacity-80 grayscale-[20%] transition duration-500 group-hover:scale-105 group-hover:opacity-100 group-hover:grayscale-0" />
        <div class="absolute inset-0 bg-gradient-to-t from-background/80 to-transparent"></div>
        <span class="absolute left-4 top-4 verified-badge">Verified Data</span>
      </div>
    ) : (
      <div class="relative aspect-[16/9] border-b border-border bg-muted blueprint-grid">
        <span class="absolute left-4 top-4 verified-badge">Verified Data</span>
        <div class="absolute inset-0 grid place-items-center text-primary/80">
          <svg viewBox="0 0 80 80" class="h-20 w-20" fill="none" aria-hidden="true">
            <circle cx="40" cy="42" r="24" stroke="currentColor" stroke-width="3" />
            <path d="M20 43c8-16 30-16 40 0" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
            <path d="M40 42l15-16" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
          </svg>
        </div>
      </div>
    )}
    <div class="flex flex-1 flex-col p-5">
      <div class="mb-3 flex flex-wrap items-center gap-2">
        {category && <span class="technical-chip">{category}</span>}
        <span class="font-mono text-[11px] font-bold uppercase tracking-[0.16em] text-muted-foreground">ASE / NHTSA cited</span>
      </div>
      <h3 class="mb-3 mt-0 text-balance text-2xl font-extrabold leading-tight transition-colors group-hover:text-primary">{title}</h3>
      <p class="mb-5 line-clamp-3 flex-1 text-sm leading-6 text-muted-foreground">{description}</p>
      <div class="flex items-center justify-between border-t border-border pt-4 text-xs font-bold uppercase tracking-[0.14em] text-muted-foreground">
        <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('en-US')}</time>
        <span>{readingTime ? `${readingTime} min` : 'Read →'}</span>
      </div>
    </div>
  </a>
</article>
