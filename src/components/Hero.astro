---
export interface Props {
  title: string;
  subtitle: string;
  ctaText?: string;
  ctaHref?: string;
}

const { title, subtitle, ctaText = 'Read latest reports', ctaHref = '#latest' } = Astro.props;
---

<section class="relative overflow-hidden border-b border-border blueprint-grid">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -left-24 top-20 h-72 w-72 rounded-full bg-primary/10 blur-3xl"></div>
    <div class="absolute right-0 top-0 h-96 w-96 rounded-full bg-accent/10 blur-3xl"></div>
  </div>

  <div class="site-shell relative py-16 md:py-24">
    <div class="grid gap-8 lg:grid-cols-[1.05fr_.95fr] lg:items-stretch">
      <div class="flex min-h-[520px] flex-col justify-between rounded border border-border bg-black/25 p-6 md:p-10">
        <div>
          <div class="mb-8 flex flex-wrap gap-3">
            <span class="technical-chip">NHTSA / DOT indexed</span>
            <span class="safety-badge">ASE-vetted safety lens</span>
          </div>
          <p class="mb-4 font-mono text-xs font-bold uppercase tracking-[0.22em] text-primary">Drive-Insight Technical Intelligence Center</p>
          <h1 class="max-w-4xl text-balance text-5xl font-black leading-[0.92] md:text-7xl lg:text-8xl">{title}</h1>
          <p class="mt-7 max-w-2xl text-pretty text-lg leading-8 text-muted-foreground md:text-xl">{subtitle}</p>
        </div>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={ctaHref} class="btn-primary">{ctaText} →</a>
          <a href="/data" class="btn-secondary">Open data hub</a>
        </div>
      </div>

      <aside class="grid gap-4 md:grid-cols-2 lg:grid-cols-1">
        <div class="ledger-card flex flex-col gap-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <span class="technical-chip">My Garage</span>
              <h2 class="mt-4 text-2xl font-extrabold">Vehicle Health Score</h2>
              <p class="mt-2 text-sm text-muted-foreground">Demo dashboard module for maintenance urgency, recall context, and ownership planning.</p>
            </div>
            <div class="gauge-ring"><span>98</span></div>
          </div>
          <div class="grid gap-3 sm:grid-cols-3">
            <div class="data-readout"><span class="value">500</span><span class="label">mi oil/filter</span></div>
            <div class="data-readout"><span class="value status-amber">34</span><span class="label">psi check</span></div>
            <div class="data-readout"><span class="value status-green">0</span><span class="label">open recalls</span></div>
          </div>
        </div>

        <div class="ledger-card">
          <div class="flex items-center justify-between border-b border-border pb-4">
            <span class="technical-chip">Live Telemetry</span>
            <span class="font-mono text-xs text-primary">ONLINE</span>
          </div>
          <div class="mt-5 space-y-4">
            <div>
              <div class="mb-2 flex justify-between text-xs font-bold uppercase tracking-[0.14em] text-muted-foreground"><span>Avg repair cost</span><span>$742</span></div>
              <div class="h-2 rounded bg-muted"><div class="h-2 w-[62%] rounded bg-primary"></div></div>
            </div>
            <div>
              <div class="mb-2 flex justify-between text-xs font-bold uppercase tracking-[0.14em] text-muted-foreground"><span>Recall frequency</span><span class="status-amber">medium</span></div>
              <div class="h-2 rounded bg-muted"><div class="h-2 w-[48%] rounded bg-accent"></div></div>
            </div>
            <div>
              <div class="mb-2 flex justify-between text-xs font-bold uppercase tracking-[0.14em] text-muted-foreground"><span>Parts longevity</span><span class="status-green">high</span></div>
              <div class="h-2 rounded bg-muted"><div class="h-2 w-[81%] rounded bg-[color:var(--data-green)]"></div></div>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
