---
import ThemeToggle from './ThemeToggle.astro';

const siteName = import.meta.env.PUBLIC_SITE_NAME || 'Drive-Insight';
const navItems = [
  { label: 'Intelligence', href: '/' },
  { label: 'Reports', href: '/posts' },
  { label: 'Data Hub', href: '/data' },
  { label: 'My Garage', href: '/garage' },
  { label: 'Process', href: '/editorial-process' },
];
---

<header class="sticky top-0 z-50 glass border-b border-border">
  <nav class="site-shell h-20 flex items-center justify-between gap-4">
    <a href="/" class="group flex items-center gap-3" aria-label={`${siteName} home`}>
      <span class="relative inline-grid h-11 w-11 place-items-center rounded border border-primary/40 bg-primary/10 text-primary shadow-[0_0_26px_rgba(0,209,255,.18)]" aria-hidden="true">
        <svg viewBox="0 0 44 44" class="h-8 w-8" fill="none">
          <circle cx="22" cy="23" r="14" stroke="currentColor" stroke-width="2" opacity=".85" />
          <path d="M12 25c3-8 15-10 22-2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path d="M22 23l8-8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
          <path d="M16 32h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".55" />
        </svg>
      </span>
      <span class="leading-none">
        <span class="block text-lg font-extrabold tracking-[-0.04em]" style="font-family: var(--font-heading)">Drive-Insight</span>
        <span class="hidden text-[10px] font-bold uppercase tracking-[0.22em] text-muted-foreground sm:block">Technical Archive</span>
      </span>
    </a>

    <div class="hidden items-center gap-1 lg:flex">
      {navItems.map((item) => (
        <a href={item.href} class="rounded px-3 py-2 text-xs font-bold uppercase tracking-[0.14em] text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
          {item.label}
        </a>
      ))}
    </div>

    <div class="hidden items-center gap-2 md:flex">
      <label class="flex h-10 items-center gap-2 rounded border border-border bg-muted/70 px-3 text-xs font-bold uppercase tracking-[0.14em] text-muted-foreground">
        <span>VIN</span>
        <input class="w-28 bg-transparent font-mono text-foreground outline-none placeholder:text-muted-foreground/60" placeholder="1HGCM826..." aria-label="VIN decoder placeholder" />
      </label>
      <select class="h-10 rounded border border-border bg-muted/70 px-3 text-xs font-bold uppercase tracking-[0.12em] text-muted-foreground" aria-label="Vehicle year">
        <option>2026</option><option>2025</option><option>2024</option><option>2020-2023</option>
      </select>
      <ThemeToggle />
    </div>

    <a href="/garage" class="btn-primary hidden xl:inline-flex">Open Garage</a>
  </nav>
</header>
