---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const POSTS_PER_PAGE = 9;
const categorySlug = (category: string) => category.toLowerCase().trim().replace(/\s+/g, '-');
const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const byCategory = posts.reduce((acc, post) => {
  const cat = post.data.category || 'general';
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(post);
  return acc;
}, {} as Record<string, typeof posts>);
const categories = Object.keys(byCategory).sort();
const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
const pagePosts = posts.slice(0, POSTS_PER_PAGE);
---

<BaseLayout title="Diagnostic Report Archive" description={`Complete Drive-Insight technical archive: ${posts.length} automotive safety, reliability, maintenance, and ownership reports.`}>
  <section class="site-shell py-16 md:py-24">
    <div class="grid gap-8 border-b border-border pb-12 lg:grid-cols-[1fr_380px] lg:items-end">
      <div>
        <span class="technical-chip">¶ Archive</span>
        <h1 class="mt-5 max-w-4xl text-balance text-5xl font-black leading-none md:text-7xl">Verified automotive intelligence.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">Every report is presented as a technical ledger: category, date, evidence layer, and practical safety context before the reader commits to a buying or maintenance decision.</p>
      </div>
      <div class="ledger-card">
        <label class="block text-xs font-bold uppercase tracking-[0.16em] text-muted-foreground" for="archive-search">Search current page</label>
        <input id="archive-search" type="search" placeholder="Try: tire, EV, OBD, heat" class="mt-3 w-full rounded border border-border bg-muted px-4 py-3 text-foreground outline-none focus:border-primary" />
        <div class="mt-4 flex flex-wrap gap-2">
          <a href="/categories/" class="technical-chip">Categories</a>
          <a href="/search/" class="technical-chip">Full search</a>
        </div>
      </div>
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
      <p class="font-mono text-sm text-muted-foreground"><span id="result-count">{pagePosts.length}</span> shown · {posts.length} total · page 1 of {totalPages}</p>
      <div class="flex flex-wrap gap-2">
        {categories.slice(0, 8).map((cat) => <a href={`/category/${categorySlug(cat)}/`} class="technical-chip">{cat} ({byCategory[cat].length})</a>)}
      </div>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" id="post-grid">
      {pagePosts.map((post, i) => (
        <div data-post-card data-title={`${post.data.title} ${post.data.description} ${post.data.category}`.toLowerCase()}>
          <ArticleCard title={post.data.title} description={post.data.description} href={`/posts/${post.slug}`} image={post.data.heroImage} category={post.data.category} pubDate={post.data.pubDate} variant="standard" index={i} />
        </div>
      ))}
    </div>

    {totalPages > 1 && (
      <nav class="mt-16 border-t border-border pt-10" aria-label="Post pagination">
        <p class="mb-4 font-mono text-[10px] uppercase tracking-[0.25em] text-muted-foreground">Pages</p>
        <ol class="flex flex-wrap gap-2">
          {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
            <li>
              <a href={page === 1 ? '/posts/' : `/posts/page/${page}/`} aria-current={page === 1 ? 'page' : undefined} class:list={['inline-flex h-10 min-w-10 items-center justify-center rounded border px-3 text-sm font-mono transition-colors', page === 1 ? 'border-primary bg-primary text-primary-foreground' : 'border-border bg-card hover:border-primary hover:text-primary']}>
                {page}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}
  </section>

  <script is:inline>
    const archiveSearch = document.getElementById('archive-search');
    const cards = Array.from(document.querySelectorAll('[data-post-card]'));
    const resultCount = document.getElementById('result-count');
    function applyArchiveFilter() {
      const q = (archiveSearch?.value || '').trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const show = !q || card.dataset.title.includes(q);
        card.style.display = show ? '' : 'none';
        if (show) visible += 1;
      });
      if (resultCount) resultCount.textContent = String(visible);
    }
    archiveSearch?.addEventListener('input', applyArchiveFilter);
  </script>
</BaseLayout>
