---
import BaseLayout from '../layouts/BaseLayout.astro';

const rows = [
  ['Avg repair cost', '$742', 'Cost telemetry', 'Compare ownership exposure before buying.'],
  ['Safety recall frequency', 'MED', 'Warning signal', 'Flag vehicles that need NHTSA recall verification.'],
  ['Parts longevity index', '81%', 'Reliability signal', 'Translate maintenance intervals into inspection questions.'],
  ['Trip-readiness risk', 'LOW', 'Safety planning', 'Connect tires, cooling, lights, and emergency-kit checks.'],
];
---

<BaseLayout title="Automotive Data Hub" description="Drive-Insight data visualization modules for repair cost, recall frequency, parts longevity, and safety-readiness signals.">
  <section class="site-shell py-14 md:py-20">
    <span class="technical-chip">Section 01 / Data Hub</span>
    <h1 class="mt-6 max-w-4xl text-balance text-5xl font-black leading-none md:text-7xl">A technical ledger for ownership risk.</h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">This module translates raw automotive evidence into visible readouts: cost, safety, longevity, and maintenance urgency.</p>

    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {rows.map(([label, value, type, desc]) => (
        <div class="ledger-card">
          <span class="technical-chip">{type}</span>
          <div class="mt-6 font-mono text-5xl font-bold text-primary">{value}</div>
          <h2 class="mt-5 text-2xl">{label}</h2>
          <p class="mt-3 text-sm leading-6 text-muted-foreground">{desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 ledger-card">
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-border pb-5">
        <div>
          <span class="technical-chip">Live telemetry mock</span>
          <h2 class="mt-4">Reliability signal stack</h2>
        </div>
        <span class="font-mono text-sm text-primary">ONLINE</span>
      </div>
      <div class="mt-8 space-y-6">
        <div><div class="mb-2 flex justify-between text-xs font-bold uppercase tracking-[0.14em] text-muted-foreground"><span>Repair cost pressure</span><span>62%</span></div><div class="h-3 rounded bg-muted"><div class="h-3 w-[62%] rounded bg-primary"></div></div></div>
        <div><div class="mb-2 flex justify-between text-xs font-bold uppercase tracking-[0.14em] text-muted-foreground"><span>Recall attention</span><span class="status-amber">48%</span></div><div class="h-3 rounded bg-muted"><div class="h-3 w-[48%] rounded bg-accent"></div></div></div>
        <div><div class="mb-2 flex justify-between text-xs font-bold uppercase tracking-[0.14em] text-muted-foreground"><span>Parts longevity</span><span class="status-green">81%</span></div><div class="h-3 rounded bg-muted"><div class="h-3 w-[81%] rounded bg-[color:var(--data-green)]"></div></div></div>
      </div>
    </div>
  </section>
</BaseLayout>
