---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ArticleCard from '../components/ArticleCard.astro';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPosts = posts.slice(0, 3);
const recentPosts = posts.slice(3, 12);
const siteDescription = import.meta.env.PUBLIC_SITE_DESCRIPTION || 'Automotive safety, reliability, and ownership intelligence.';
const heroTitle = import.meta.env.PUBLIC_SITE_HERO_TITLE || 'Used Car Decisions, Backed by Real Data';
const heroSubtitle = import.meta.env.PUBLIC_SITE_HERO_SUBTITLE || siteDescription;
---

<BaseLayout title="Car Safety, Reliability and Maintenance Guides" description={siteDescription}>
  <Hero title={heroTitle} subtitle={heroSubtitle} ctaText="Read diagnostic reports" ctaHref="#latest" />

  <section class="site-shell py-12">
    <div class="grid gap-4 md:grid-cols-4">
      <div class="data-readout"><span class="value">NHTSA</span><span class="label">Recall source layer</span></div>
      <div class="data-readout"><span class="value">DOT</span><span class="label">Safety context</span></div>
      <div class="data-readout"><span class="value">ASE</span><span class="label">Repair logic</span></div>
      <div class="data-readout"><span class="value">TCO</span><span class="label">Ownership math</span></div>
    </div>
  </section>

  <section class="site-shell py-14">
    <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div>
        <span class="technical-chip">Section 01 / Data Hub</span>
        <h2 class="max-w-3xl">Technical data, surfaced like an instrument cluster.</h2>
        <p class="max-w-2xl text-muted-foreground">The redesign moves Drive-Insight from a standard blog into a dashboard-style archive for safety, reliability, and maintenance decisions.</p>
      </div>
      <a href="/data" class="btn-secondary">Explore data hub</a>
    </div>
    <div class="grid gap-5 lg:grid-cols-3">
      <div class="ledger-card">
        <span class="technical-chip">Cost telemetry</span>
        <div class="mt-6 font-mono text-5xl font-bold text-primary">$742</div>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">Example average repair-cost panel for comparing ownership risk across vehicle segments.</p>
      </div>
      <div class="ledger-card">
        <span class="technical-chip">Recall signal</span>
        <div class="mt-6 font-mono text-5xl font-bold text-accent">MED</div>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">Safety recall frequency is treated as a warning light, not buried beneath generic buying advice.</p>
      </div>
      <div class="ledger-card">
        <span class="technical-chip">Longevity index</span>
        <div class="mt-6 font-mono text-5xl font-bold status-green">81%</div>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">Parts life and service interval guidance are framed as practical inspection questions.</p>
      </div>
    </div>
  </section>

  {featuredPosts.length > 0 && (
    <section class="site-shell py-14" id="latest">
      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <span class="technical-chip">Section 02 / Featured reports</span>
          <h2>Diagnostic reports</h2>
        </div>
        <a href="/posts" class="btn-secondary">View archive</a>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {featuredPosts.map((post) => <ArticleCard title={post.data.title} description={post.data.description} href={`/posts/${post.slug}`} image={post.data.heroImage} category={post.data.category} pubDate={post.data.pubDate} />)}
      </div>
    </section>
  )}

  <section class="site-shell py-14">
    <div class="grid gap-6 lg:grid-cols-[.9fr_1.1fr]">
      <div class="ledger-card">
        <span class="technical-chip">My Garage</span>
        <h2 class="mt-4">A personalized maintenance cockpit.</h2>
        <p class="mt-4 text-muted-foreground">The new My Garage concept gives users a visible place to reason about service windows, tire pressure checks, recalls, and trip readiness without pretending to replace a mechanic.</p>
        <a href="/garage" class="btn-primary mt-7">Open garage module</a>
      </div>
      <div class="ledger-card grid gap-4 sm:grid-cols-2">
        <div class="flex items-center gap-5">
          <div class="gauge-ring"><span>98</span></div>
          <div><p class="font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground">Health Score</p><p class="text-2xl font-bold">Optimal</p></div>
        </div>
        <div class="space-y-3 text-sm">
          <div class="flex justify-between border-b border-border pb-2"><span>Oil / filter</span><strong>500 mi</strong></div>
          <div class="flex justify-between border-b border-border pb-2"><span>Tire pressure</span><strong class="status-amber">Check</strong></div>
          <div class="flex justify-between border-b border-border pb-2"><span>Open recalls</span><strong class="status-green">0</strong></div>
        </div>
      </div>
    </div>
  </section>

  {recentPosts.length > 0 && (
    <section class="site-shell py-14">
      <h2>Recent intelligence</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {recentPosts.map((post) => <ArticleCard title={post.data.title} description={post.data.description} href={`/posts/${post.slug}`} image={post.data.heroImage} category={post.data.category} pubDate={post.data.pubDate} />)}
      </div>
    </section>
  )}
</BaseLayout>
